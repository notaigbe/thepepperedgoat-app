{
  "expo": {
    "name": "The Peppered Goat",
    "slug": "the-peppered-goat",
    "version": "1.5.11",
    "orientation": "portrait",
    "icon": "./assets/images/peppered-goat-logo.jpg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/peppered-goat-logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ooosumfoods.thepepperedgoat",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Your camera is used to take a photo for your profile picture.",
        "NSPhotoLibraryUsageDescription": "Your photo library is used to choose an existing photo for your profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/peppered-goat-logo.jpg",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ooosumfoods.thepepperedgoat"
    },
    "web": {
      "favicon": "./assets/images/peppered-goat-logo.jpg",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.ooosumfoods.thepepperedgoat",
          "enableGooglePay": true
        }
      ],
      "expo-build-properties",
      "expo-sharing"
    ],
    "scheme": "thepepperedgoat",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85dee9c3-316f-4103-bdcb-6c322c575992"
      }
    }
  }
}
